[Unit]
Description=Taskmanager FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alexis
Group=alexis
WorkingDirectory=/home/alexis/taskmanager/backend
EnvironmentFile=/etc/taskmanager/taskmanager.env
ExecStart=/home/alexis/taskmanager/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
